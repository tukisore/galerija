# Copy to .env and fill in; .env is not committed. Leave a value empty to use its default.

# PostgreSQL JDBC URL, e.g. jdbc:postgresql://localhost:5432/scalaweb; when empty, SQLite is used
DB_URL=
DB_USER=
DB_PASSWORD=
# SQLite database file, when DB_URL is empty (default: db)
DB_PATH=
# directory for uploaded media files (default: media)
MEDIA_DIR=

# secret for signing login tokens; without it sessions end when the server restarts
JWT_SECRET=
# true when served over https
COOKIE_SECURE=

# MailerSend API token; without it emails are printed to the server console instead
MAILERSEND_API_KEY=
# sender address, on a domain verified in MailerSend
MAIL_FROM=
MAIL_FROM_NAME=
